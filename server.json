  "name": "io.github.Rohanxmalik/tower",
  "title": "Tower",
  "description": "Multiplayer for AI coding agents: collision detection before the edit, messaging, delegation.",
  "version": "0.12.1",
  "websiteUrl": "https://rohanxmalik.github.io/Tower",
  "icons": [
    {
      "src": "https://rohanxmalik.github.io/Tower/logo.png",
