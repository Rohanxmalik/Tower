      "sizes": ["400x400"]
    }
  ],
  "repository": {
    "url": "https://github.com/Rohanxmalik/Tower",
    "source": "github",
    "id": "1287233581"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "tower-mcp",
